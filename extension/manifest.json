{
  "manifest_version": 3,
  "name": "InjectGuard — Hidden Prompt-Injection Scanner",
  "short_name": "InjectGuard",
  "version": "0.0.6",
  "description": "Warns you when a web page hides instructions aimed at AI assistants (white text, hidden elements, invisible Unicode, comments).",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "InjectGuard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "contextMenus", "notifications", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["rules.js", "detector.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+Shift+I"}, "description": "Open InjectGuard"},
    "scan-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Re-scan this page"},
    "reveal-hidden": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Reveal hidden text"}
  }
}
